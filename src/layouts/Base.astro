---
import '../styles/global.css';
import site from '../data/site.json';
import { makeRel } from '../lib/rel';

interface Props { title: string; description: string; jsonld?: object | object[]; ogType?: string; current?: string; }
const { title, description, jsonld, ogType = 'website', current = '' } = Astro.props;
const r = makeRel(Astro.url);
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '/'), Astro.site).href;
const nav = [
  { href: 'index.html', label: 'Home', key: 'home' },
  { href: 'cv.html', label: 'CV', key: 'cv' },
  { href: 'research.html', label: 'Research', key: 'research' },
  { href: 'blog.html', label: 'Blog', key: 'blog' },
  { href: 'media.html', label: 'Media', key: 'media' },
  { href: 'contact.html', label: 'Contact', key: 'contact' },
];
const fullTitle = title === site.name ? `${site.name}, ${site.title} | Dubai` : `${title} | ${site.name}`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<meta name="author" content={site.name}>
<meta name="robots" content="index, follow, max-image-preview:large">
<meta name="theme-color" content="#0B0F1A">
<link rel="canonical" href={canonical}>
<link rel="icon" type="image/png" href={r('favicon.png')}>
<link rel="sitemap" href={r('sitemap-index.xml')}>
<meta property="og:type" content={ogType}>
<meta property="og:url" content={canonical}>
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:site_name" content={`${site.name}, Critical Care Intensivist`}>
<meta property="og:image" content={new URL('img/og.jpg', Astro.site).href}>
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="geo.region" content="AE-DU">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,500&family=Manrope:wght@400;500;600;700&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)}></script>}
<slot name="head" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap nav">
    <a class="brand" href={r('index.html')}>
      <img src={r('img/logo.webp')} alt="" width="40" height="40">
      <span class="gold-name">{site.name}</span>
    </a>
    <nav aria-label="Main">
      <div class="nav-links" id="nav-links">
        {nav.map((n) => <a href={r(n.href)} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>)}
      </div>
    </nav>
    <div class="nav-tools">
      <button class="icon-btn" type="button" id="search-open" aria-label="Search the site">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
      </button>
      <a class="btn btn-gold nav-cv" href={r('cv/Dr-Mohamed-Khalil-CV.pdf')} download>Download CV</a>
      <button class="icon-btn menu-btn" type="button" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
        <svg width="20" height="14" viewBox="0 0 20 14" aria-hidden="true"><path d="M0 1H20M0 7H20M0 13H20" stroke="currentColor" stroke-width="1.8"></path></svg>
      </button>
    </div>
  </div>
</header>

<dialog class="search-dlg" id="search-dlg" aria-label="Search">
  <div class="search-top">
    <input type="search" id="search-q" placeholder="Search articles, research, licenses, roles" aria-label="Search terms" autocomplete="off">
    <button class="icon-btn" type="button" id="search-close" aria-label="Close search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
    </button>
  </div>
  <ul class="search-results" id="search-results" aria-live="polite"></ul>
</dialog>

<main id="main">
  <slot />
</main>

<footer class="site-footer">
  <div class="wrap">
    <div class="foot">
      <div>
        <div class="name gold-name">{site.name}</div>
        <p style="margin-top:8px">{site.title} · {site.employer}</p>
        <p style="margin-top:12px;font-style:italic">"{site.tagline}"</p>
      </div>
      <div>
        <h2>Explore</h2>
        <ul>{nav.map((n) => <li><a href={r(n.href)}>{n.label}</a></li>)}</ul>
      </div>
      <div>
        <h2>Contact</h2>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.whatsappLink} rel="noopener">WhatsApp {site.whatsapp}</a></li>
          <li>{site.location}</li>
        </ul>
      </div>
      <div>
        <h2>Follow</h2>
        <ul>
          <li><a href={site.social.linkedin} rel="noopener">LinkedIn</a></li>
          <li><a href={site.social.facebook} rel="noopener">Facebook</a></li>
          <li><a href={site.social.linktree} rel="noopener">Linktree</a></li>
        </ul>
      </div>
    </div>
    <div class="copy">
      <span>© {new Date().getFullYear()} {site.name} · icukhalil.com</span>
      <span>Educational content is for healthcare professionals and is not individual medical advice.</span>
    </div>
  </div>
</footer>

<script is:inline define:vars={{ searchUrl: r('search.json'), base: r('') }}>
{
  const menu = document.getElementById('menu-btn');
  const links = document.getElementById('nav-links');
  menu.addEventListener('click', () => {
    const open = links.classList.toggle('open');
    menu.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });

  const io = 'IntersectionObserver' in window ? new IntersectionObserver((es) => {
    es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.08 }) : null;
  document.querySelectorAll('.rv, .letter').forEach((el) => io ? io.observe(el) : el.classList.add('in'));

  const dlg = document.getElementById('search-dlg');
  const q = document.getElementById('search-q');
  const out = document.getElementById('search-results');
  let index = null;
  const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const render = () => {
    const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
    if (!index) { out.innerHTML = '<li class="search-empty">Loading…</li>'; return; }
    if (!terms.length) { out.innerHTML = '<li class="search-empty">Type a word such as ECMO, ultrasound, DHA or Dammam.</li>'; return; }
    const hits = index.filter((it) => { const hay = (it.t + ' ' + it.k + ' ' + it.d).toLowerCase(); return terms.every((t) => hay.includes(t)); }).slice(0, 12);
    out.innerHTML = hits.length ? hits.map((h) => `<li><a href="${base}${h.u}"><small>${esc(h.k)}</small>${esc(h.t)}<span>${esc(h.d.slice(0, 120))}</span></a></li>`).join('')
      : '<li class="search-empty">No results. Try a shorter word.</li>';
  };
  document.getElementById('search-open').addEventListener('click', async () => {
    dlg.showModal(); q.focus(); render();
    if (!index) { try { index = await (await fetch(searchUrl)).json(); } catch (e) { index = []; } render(); }
  });
  document.getElementById('search-close').addEventListener('click', () => dlg.close());
  q.addEventListener('input', render);
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
}
</script>
<slot name="scripts" />
</body>
</html>
